# AI food scan — point this at your deployed Vercel proxy (food-scan-api/).
# Copy this file to .env.local and fill in your value.
# Leave blank to disable the scan feature (the button simply won't appear).
VITE_FOOD_SCAN_API_URL=https://your-food-scan-api.vercel.app

# Shared-beta mode — OFF by default, only for a build made specifically to
# hand to external testers. Leave both commented out for your normal
# day-to-day build. See TESTFLIGHT.md "Shared beta mode" for the full story.
# VITE_SHARED_BETA=true
# VITE_SHARED_BETA_ANTHROPIC_KEY=sk-ant-your-temporary-key
